# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas connection string (M0 free tier is enough).
# Create a cluster at https://cloud.mongodb.com, add a database user,
# allow access from 0.0.0.0/0 (or Vercel's IPs), then copy the connection string.
# Include a database name in the path (here: cdt_db) so the app knows which DB to use.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cdt_db?retryWrites=true&w=majority
